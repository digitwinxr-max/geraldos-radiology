# ─── GeraldOS Core ─────────────────────────────────────────────────────────────
# Required in every environment.
#
# DATABASE_URL points at the `postgres` Docker service hostname when running
# under compose; use 127.0.0.1 for local development against the loopback-only
# published port. On Render it is injected automatically from the linked
# database — never set it by hand there.
#
# IMPORTANT: the local Docker Compose Postgres does not enable TLS, so the URL
# MUST carry `sslmode=disable` here, otherwise the app's default pool will
# attempt an SSL handshake and the database will reject it. On Render the URL
# is injected without sslmode, and the app's default behavior is to negotiate
# TLS with `rejectUnauthorized: false` — Render's internal PG accepts that.
# Therefore:
#   - Local docker compose → include `?sslmode=disable`.
#   - Render (production)   → omit sslmode entirely.
#
# The password below must match POSTGRES_PASSWORD (compose interpolates that
# variable into the database container). These are placeholders, not defaults —
# replace both with the same strong local value.
POSTGRES_USER=geraldos_admin
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=geraldos
DATABASE_URL=postgresql://geraldos_admin:replace-with-local-postgres-password@postgres:5432/geraldos?sslmode=disable

# AUTH_SECRET: REQUIRED in production. Generate with: openssl rand -base64 32
# Must NOT be "geraldos-dev-secret-change-me" in production.
AUTH_SECRET=replace-with-32-byte-random-secret
# DEV_AUTH: allow dev admin sign-in (development only — hard-disabled when
# NODE_ENV=production, so it can never be enabled on Render).
DEV_AUTH=false
# PUBLIC_APP_URL: browser-facing origin of THIS app, used for post-login
# redirects and for the CSRF Origin allow-list. Required in production when the
# app runs behind a reverse proxy / TLS terminator (e.g. Render) — set it to the
# public URL, such as https://geraldos-radiology.onrender.com. Omit it in local
# development to fall back to the request origin.
PUBLIC_APP_URL=

# ─── First-administrator bootstrap (one-time, production) ─────────────────────
# Used ONLY by `node scripts/db-seed.mjs bootstrap-admin` (or
# `npm run db:bootstrap-admin`). Set these as SECRETS in the deployment
# environment (Render Dashboard / Render Shell) — never commit them.
#   ADMIN_EMAIL=<first-admin@your-domain>
#   ADMIN_PASSWORD=<strong password, min 12 characters>
# The bootstrap hashes the password with the native-auth scrypt parameters and
# upserts a single role=administrator, status=active staff row (idempotent).

# ─── Orthanc (Primary DICOM server · DICOMweb) ────────────────────────────────
# Server-side only. The browser never learns this address: every image request
# goes through the authenticated /api/orthanc/* proxy routes.
#   - compose → http://orthanc:8042 (service hostname)
#   - Render  → injected automatically as the private service's `host:port`
#               (no scheme; src/lib/integrations normalises it)
ORTHANC_URL=http://orthanc:8042
ORTHANC_USERNAME=orthanc
# REQUIRED, and must equal the password in Orthanc's RegisteredUsers. With
# authentication enabled and no registered user, Orthanc denies every request
# (fails closed) and the Settings page reports it as unreachable.
ORTHANC_PASSWORD=replace-with-strong-orthanc-password

# ─── OHIF Viewer (web image viewer) ────────────────────────────────────────────
# Server-side only: the internal address of the viewer container/service. The
# Next.js app reverse-proxies it at /viewer on its OWN origin (see the rewrites
# in next.config.ts and src/app/api/ohif/[[...path]]/route.ts), so the browser
# never requests this address directly.
#   - compose → http://ohif:80 (service hostname; no port is published)
#   - Render  → injected automatically as the private service's `host:port`
OHIF_URL=http://ohif:80
# There is deliberately no OHIF_PUBLIC_URL. The viewer shares the app's origin,
# which is what lets the SameSite=Lax session cookie authorise its DICOMweb
# calls. A viewer on a separate hostname is cross-site with the app on Render's
# `*.onrender.com` (a public suffix), so it could never be authenticated.
# Clients are told to use the path prefix "/viewer" by
# /api/integrations/client-config — no configuration needed here.

# ─── Security posture (no configuration needed) ───────────────────────────────
# Security headers (CSP, X-Frame-Options DENY, Referrer-Policy, Permissions-Policy)
# are enforced server-side via next.config.ts headers(). The proxied /viewer
# namespace gets its own policy that permits same-origin framing.
# Rate limiting protects /api/auth/* and /api/agents/chat.
# Cookie-authenticated mutations are validated against a strict Origin check
# (CSRF) in addition to the SameSite=Lax session cookie.

# ─── Observability ─────────────────────────────────────────────────────────────
# LOG_LEVEL: debug | info | warn | error (default: info; debug in development).
# All application logs are structured JSON lines (level, msg, requestId, route,
# durationMs, userId); request metrics are exposed via GET /api/metrics
# (public, alongside /api/health, for container monitoring).
LOG_LEVEL=info

# ─── Build-time only ───────────────────────────────────────────────────────────
# ANALYZE: set to "true" to emit bundle-analyzer HTML reports under .next/analyze.
# Reports are webpack-based, so pair it with the webpack build, e.g.:
#   $env:ANALYZE="true"; npx next build --webpack
# Ignored at runtime; not needed in production containers.
ANALYZE=

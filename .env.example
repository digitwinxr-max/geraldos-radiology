# ─── GeraldOS Core ─────────────────────────────────────────────────────────────
# Required in every environment.
# DATABASE_URL points at the `postgres` Docker service hostname when running
# under compose; use 127.0.0.1 for local development against a port-forwarded
# database.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
DATABASE_URL=postgresql://geraldos_admin:geraldos_secure_pass@postgres:5432/geraldos
# AUTH_SECRET: REQUIRED in production. Generate with: openssl rand -base64 32
# Must NOT be "geraldos-dev-secret-change-me" in production.
AUTH_SECRET=replace-with-32-byte-random-secret
# DEV_AUTH: allow dev admin sign-in when Keycloak is not yet configured (development only)
DEV_AUTH=false

# ─── Optional: Keycloak (Authentication · RBAC · SSO) ─────────────────────────
# Leave KEYCLOAK_URL empty to run in degraded mode without identity provider.
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=geraldos
KEYCLOAK_CLIENT_ID=geraldos-frontend
KEYCLOAK_CLIENT_SECRET=

# ─── Optional: Orthanc (Primary DICOM server · DICOMweb) ──────────────────────
ORTHANC_URL=http://orthanc:8042
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=orthanc_secure_pass

# ─── Optional: OHIF Viewer (web image viewer) ─────────────────────────────────
OHIF_URL=http://ohif:80

# ─── Optional: Dicoogle (search & indexing) ───────────────────────────────────
DICOOGLE_URL=http://dicoogle:8081

# ─── Optional: HAPI FHIR (clinical interoperability) ──────────────────────────
FHIR_URL=http://hapi-fhir:8080/fhir

# ─── Optional: n8n (workflow automation) ──────────────────────────────────────
N8N_URL=http://n8n:5678
N8N_WEBHOOK_BASE=http://n8n:5678/webhook
N8N_API_KEY=

# ─── Optional: LangGraph (AI agent orchestration) ─────────────────────────────
LANGGRAPH_URL=http://langgraph:8000
LANGGRAPH_API_KEY=
LANGGRAPH_ASSISTANT_ID=geraldos-agent

# ─── Optional: MinIO (object storage) ─────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=geraldos
MINIO_SECRET_KEY=geraldos-secret
MINIO_BUCKET=geraldos
MINIO_REGION=us-east-1

# ─── Optional: Redis (cache & queues) ─────────────────────────────────────────
# Backs the event bus stream AND API rate limiting. When unset, rate limits
# fall back to per-instance in-memory counters and events persist to Postgres only.
REDIS_URL=redis://redis:6379

# ─── Security posture (no configuration needed) ───────────────────────────────
# Security headers (CSP, X-Frame-Options DENY, Referrer-Policy, Permissions-Policy)
# are enforced server-side via next.config.ts headers().
# Rate limiting protects /api/auth/*, /api/webhooks/n8n and /api/agents/chat.
# Cookie-authenticated mutations are validated against a strict Origin check
# (CSRF) in addition to the SameSite=Lax session cookie.
